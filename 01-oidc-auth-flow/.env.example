ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-her
ENTRA_CLIENT_SECRET=your-client-secret-here
REDIRECT_URI=http://localhost:5000/callback
# Optional; defaults to app root derived from REDIRECT_URI (…/callback → …/)
# POST_LOGOUT_REDIRECT_URI=http://localhost:5000/
# Deploy: set REDIRECT_URI=https://oidc.alanvpv.dev/callback
# (and register both callback + logout URIs in the Entra app)
FLASK_SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-hex-32

# Local development only — never enable on a public host
# FLASK_DEBUG=1
