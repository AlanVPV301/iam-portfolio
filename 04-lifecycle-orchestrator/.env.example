# SQLite database file (created on first run)
DATABASE_PATH=./data/orchestrator.db

# Inbound API credential — protects /hr/events and the read endpoints.
# Export as ORCH_TOKEN to run the demo scripts.
ORCHESTRATOR_BEARER_TOKEN=change-me-to-a-long-random-secret

# Project 3 SCIM server (orchestrator runs on :8000, SCIM on :8001)
SCIM_BASE_URL=http://127.0.0.1:8001
# Deploy example (point at public SCIM origin, no trailing slash):
# SCIM_BASE_URL=https://scim.alanvpv.dev
SCIM_BEARER_TOKEN=change-me-same-as-03-scim-server
