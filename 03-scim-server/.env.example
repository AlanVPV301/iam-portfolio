# Bearer token — use the same value in 04-lifecycle-orchestrator/.env
SCIM_BEARER_TOKEN=change-me-to-a-long-random-secret
DATABASE_PATH=./data/scim.db

# Public origin used in SCIM meta.location (no trailing slash)
# Local (alongside orchestrator on :8000):
PUBLIC_BASE_URL=http://127.0.0.1:8001
# Deploy example:
# PUBLIC_BASE_URL=https://scim.alanvpv.dev
